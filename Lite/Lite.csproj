<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.2</Version>

    <!-- NuGet package metadata -->
    <PackageId>danisss9.Lite</PackageId>
    <Authors>danisss9</Authors>
    <Description>Lightweight HTML/CSS/JS rendering engine for Windows.</Description>
    <PackageTags>html;css;javascript;renderer;browser;lite;win32</PackageTags>
    <RepositoryUrl>https://github.com/danisss9/Lite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lite.Tests" />
    <InternalsVisibleTo Include="Lite.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp.Xml" />
    <ProjectReference Include="..\Lite.QuickJs\Lite.QuickJs.csproj" />
    <ProjectReference Include="..\Lite.AngleSharp\Lite.AngleSharp.csproj" />
    <!-- AngleSharp.Css is vendored too (CSS 2.1 parser patches); see Lite.AngleSharp.Css/README.md. -->
    <ProjectReference Include="..\Lite.AngleSharp.Css\Lite.AngleSharp.Css.csproj" />
    <!-- The vendored Lite.AngleSharp project provides the AngleSharp assembly itself; this
         graph entry keeps AngleSharp.Xml's NuGet dependency satisfied while excluding the
         package's own DLL from compile and runtime. -->
    <PackageReference Include="AngleSharp" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

</Project>
