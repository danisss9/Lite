<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0</Version>
    <PackageId>danisss9.Lite.QuickJs</PackageId>
    <Authors>danisss9</Authors>
    <Description>QuickJS native bridge and managed runtime for Lite on Windows x64 and Linux x64.</Description>
    <PackageTags>quickjs;javascript;lite;win32;linux</PackageTags>
    <RepositoryUrl>https://github.com/danisss9/Lite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- The native bridge is built for the host OS: MinGW litequickjs.dll on Windows (win-x64),
       gcc liblitequickjs.so on Linux (linux-<arch>). A package built on one OS also carries the
       other OS's asset when CI has dropped it into runtimes/ before packing. -->
  <PropertyGroup>
    <QuickJsWindowsNative>$(MSBuildProjectDirectory)\runtimes\win-x64\native\litequickjs.dll</QuickJsWindowsNative>
    <QuickJsLinuxNative>$(MSBuildProjectDirectory)/runtimes/linux-x64/native/liblitequickjs.so</QuickJsLinuxNative>
    <QuickJsHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</QuickJsHostArch>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <QuickJsNativeRid>win-x64</QuickJsNativeRid>
    <QuickJsNativeFile>litequickjs.dll</QuickJsNativeFile>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <QuickJsNativeRid>linux-$(QuickJsHostArch)</QuickJsNativeRid>
    <QuickJsNativeFile>liblitequickjs.so</QuickJsNativeFile>
  </PropertyGroup>
  <PropertyGroup>
    <QuickJsNativeOutput Condition="'$(QuickJsNativeOutput)' == ''">$(MSBuildProjectDirectory)/runtimes/$(QuickJsNativeRid)/native/$(QuickJsNativeFile)</QuickJsNativeOutput>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lite" />
    <InternalsVisibleTo Include="Lite.Tests" />
    <InternalsVisibleTo Include="Lite.Conformance" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="native\LICENSE.quickjs.txt" Pack="true" PackagePath="licenses\LICENSE.quickjs.txt" />
    <Content Include="$(QuickJsNativeOutput)" Link="runtimes\$(QuickJsNativeRid)\native\$(QuickJsNativeFile)" CopyToOutputDirectory="PreserveNewest"
             Pack="true" PackagePath="runtimes\$(QuickJsNativeRid)\native\" />
    <Content Include="$(QuickJsNativeOutput).build.json" Link="runtimes\$(QuickJsNativeRid)\native\$(QuickJsNativeFile).build.json"
             CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\$(QuickJsNativeRid)\native\" />
  </ItemGroup>

  <!-- Cross-OS assets: packed only (never copied to this OS's build output) when present. -->
  <ItemGroup Condition="'$(QuickJsNativeRid)' != 'win-x64' And Exists('$(QuickJsWindowsNative)')">
    <None Include="$(QuickJsWindowsNative);$(QuickJsWindowsNative).build.json" Pack="true" PackagePath="runtimes\win-x64\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(QuickJsNativeRid)' != 'linux-x64' And Exists('$(QuickJsLinuxNative)')">
    <None Include="$(QuickJsLinuxNative);$(QuickJsLinuxNative).build.json" Pack="true" PackagePath="runtimes\linux-x64\native\" />
  </ItemGroup>

  <!-- Default: build the bridge from the pinned archive + patches (MinGW-w64 gcc on Windows,
       gcc on Linux). The scripts skip the compile when the existing library and its .build.json
       record already match the current inputs. -->
  <Target Name="BuildQuickJsNative" BeforeTargets="CoreCompile" Condition="'$(LiteQuickJsPrebuilt)' != 'true'">
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" ContinueOnError="true"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-quickjs.ps1&quot; -OutputPath &quot;$(QuickJsNativeOutput)&quot;">
      <Output TaskParameter="ExitCode" PropertyName="_QuickJsNativeExitCode" />
    </Exec>
    <Error Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_QuickJsNativeExitCode)' != '0'"
           Text="build-quickjs.ps1 failed (exit $(_QuickJsNativeExitCode)). Without MinGW-w64 gcc, build with -p:LiteQuickJsPrebuilt=true (optionally -p:LiteQuickJsPrebuiltSource=&lt;litequickjs.dll&gt;) to use a prebuilt bridge verified against the committed build record; see docs/es2020-conformance.md, Reproduce." />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="bash &quot;$(MSBuildProjectDirectory)/build-quickjs.sh&quot; --output-path &quot;$(QuickJsNativeOutput)&quot;" />
  </Target>

  <!-- Opt-in (LiteQuickJsPrebuilt=true, as an MSBuild property or environment variable): no
       compiler is invoked. verify-quickjs-prebuilt.ps1 recomputes build-quickjs.ps1's input
       fingerprint from the checked-out sources and fails the build unless it equals the committed
       record's inputSha256 and the dll's SHA-256 equals its nativeDllSha256. The dll is untracked;
       LiteQuickJsPrebuiltSource copies one into place first (e.g. into a fresh worktree). -->
  <Target Name="VerifyQuickJsPrebuilt" BeforeTargets="CoreCompile" Condition="'$(LiteQuickJsPrebuilt)' == 'true'">
    <Error Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
           Text="LiteQuickJsPrebuilt is supported on Windows only; on Linux install gcc and build without it." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\verify-quickjs-prebuilt.ps1&quot; -OutputPath &quot;$(QuickJsNativeOutput)&quot; -PrebuiltSource &quot;$(LiteQuickJsPrebuiltSource)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Acornima" />
  </ItemGroup>

</Project>
