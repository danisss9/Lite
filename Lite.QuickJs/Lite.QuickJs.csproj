<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.16</Version>
    <PackageId>danisss9.Lite.QuickJs</PackageId>
    <Authors>danisss9</Authors>
    <Description>QuickJS native bridge and managed runtime for Lite on Windows x64.</Description>
    <PackageTags>quickjs;javascript;lite;win32</PackageTags>
    <RepositoryUrl>https://github.com/danisss9/Lite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lite" />
    <InternalsVisibleTo Include="Lite.Tests" />
    <InternalsVisibleTo Include="Lite.Conformance" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="native\LICENSE.quickjs.txt" Pack="true" PackagePath="licenses\LICENSE.quickjs.txt" />
    <Content Include="runtimes\win-x64\native\litequickjs.dll" CopyToOutputDirectory="PreserveNewest"
             Pack="true" PackagePath="runtimes\win-x64\native\" />
  </ItemGroup>

  <Target Name="BuildQuickJsNative" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\native\litequickjs.c;$(MSBuildProjectDirectory)\build-quickjs.ps1"
          Outputs="$(MSBuildProjectDirectory)\runtimes\win-x64\native\litequickjs.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-quickjs.ps1&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Acornima" />
  </ItemGroup>

</Project>
