+/* A strict tail call transfers ownership of its operands out of the current
+   bytecode frame. The caller's C frame must unwind before the next function
+   enters the interpreter. */
+typedef struct JSTailCall {
+    JSContext *ctx;
+    JSValue func;
+    JSValue this_val;
+    JSValue *argv;
+    int argc;
+    BOOL active;
+} JSTailCall;
+
+static int js_prepare_tail_call(JSContext *ctx, JSTailCall *tail,
+                                JSValueConst func, JSValueConst this_val,
+                                int argc, JSValue *argv)
+{
+    JSValue *args = NULL;
+    int i;
+    if (argc > 0) {
+        args = js_malloc(ctx, sizeof(*args) * argc);
+        if (!args)
+            return -1;
+        for (i = 0; i < argc; i++)
+            args[i] = JS_DupValue(ctx, argv[i]);
+    }
+    tail->ctx = ctx;
+    tail->func = JS_DupValue(ctx, func);
+    tail->this_val = JS_DupValue(ctx, this_val);
+    tail->argv = args;
+    tail->argc = argc;
+    tail->active = TRUE;
+    return 0;
+}
