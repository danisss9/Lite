{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "const": "https://www.w3.org/TR/2011/REC-CSS2-20110607/"
    },
    "reviewComplete": {
      "type": "boolean"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "unreviewed",
              "applicable",
              "later-feature",
              "informative",
              "optional",
              "defective"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "enum": [
                "screen",
                "print"
              ]
            },
            "uniqueItems": true
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "classification",
          "rationale",
          "media",
          "requirementIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "target",
    "reviewComplete",
    "tests"
  ],
  "additionalProperties": false
}
