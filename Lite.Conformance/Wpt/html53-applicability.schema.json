{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "inventoryComplete",
    "defaultClassification",
    "tests"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "target": {
      "const": "https://www.w3.org/TR/2018/WD-html53-20181018/"
    },
    "inventoryComplete": {
      "type": "boolean"
    },
    "defaultClassification": {
      "const": "unreviewed"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "classification",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "included",
              "mixed",
              "unreviewed",
              "post-target",
              "regression-only",
              "profile-excluded"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "assertionInventoryComplete": { "const": true },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "classification", "reason"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "classification": { "enum": ["included", "post-target", "regression-only", "profile-excluded"] },
                "reason": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [{
          "if": { "properties": { "classification": { "const": "mixed" } } },
          "then": { "required": ["assertions", "assertionInventoryComplete"] },
          "else": { "not": { "anyOf": [{ "required": ["assertions"] }, { "required": ["assertionInventoryComplete"] }] } }
        }],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
